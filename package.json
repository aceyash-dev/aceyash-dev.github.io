{
  "name": "aceyash-portfolio",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Editorial milk-and-orange portfolio for Ace Yash / The Ace Base.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && npm run prerender",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "prerender": "node scripts/prerender.mjs",
    "verify": "node scripts/verify.mjs",
    "postbuild": "npm run verify"
  },
  "dependencies": {
    "lenis": "^1.3.28",
    "motion": "^12.23.12",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tslib": "^2.9.1",
    "@solar-icons/react": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.3",
    "vite": "^6.4.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}